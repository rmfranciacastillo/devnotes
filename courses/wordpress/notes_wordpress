WP API
------

Alter API hook
function university_custom_rest() {
  register_rest_field('post', 'customField' , [
    'get_callback' => function() { ... }, 
  ]);

}

add_action('rest_api_init', 'university_custom_rest');

// URLs
<localhost>/wp-json/wp/v2/pages   
<localhost>/wp-json/wp/v2/posts

<localhost>/wp-json/wp/v2/posts?per_page=1
<localhost>/wp-json/wp/v2/posts/{id}                      // Specific post by ID
<localhost>/wp-json/wp/v2/posts?search={text}             // Search by text 

// Register new API field endpoint
// "Hooks" in the API response.
register_rest_field('post', 'authorName', array(
  'get_callback' => function() { return get_the_author(); },
))




